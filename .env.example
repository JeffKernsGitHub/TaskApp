# ==============================================================================
# TaskApp Environment Variables (Copy to .env to override defaults)
# ==============================================================================

# Frontend NGINX published port on host
FRONTEND_PORT=80

# Optional direct backend published port on host (defaults to 8081 to avoid colliding with local IDEs on 8080)
BACKEND_HOST_PORT=8081

# PostgreSQL credentials
POSTGRES_DB=mydatabase
POSTGRES_USER=pguser
POSTGRES_PASSWORD=SecretPassword123

# Spring Boot Application Database credentials
APP_DB_USER=spring_boot_user
APP_DB_PASSWORD=ServerAppSecret123!
